# Neon Postgres connection strings.
# Get these from your Neon project dashboard (Connection Details).
#
# DATABASE_URL: pooled connection, used by the running application.
DATABASE_URL="postgresql://user:password@ep-example-000000-pooler.region.aws.neon.tech/dbname?sslmode=require"
#
# DATABASE_URL_UNPOOLED: direct (unpooled) connection, used for running
# Drizzle migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example-000000.region.aws.neon.tech/dbname?sslmode=require"
